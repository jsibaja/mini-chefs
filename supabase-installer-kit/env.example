# MiniChefs — Variables de entorno
#
# Copia este archivo a `.env` en la raíz del proyecto y rellena los valores.
# NUNCA subas `.env` al repositorio.

# --- Supabase ---
# URL del proyecto Supabase (ej. https://xxxxx.supabase.co)
SUPABASE_URL=
# Publishable key (antes anon key). Segura para el cliente.
SUPABASE_PUBLISHABLE_KEY=
# Service role key. SOLO para edge functions y servidor. Nunca al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Espejo con prefijo VITE_ para el bundle del cliente
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Resend (emails transaccionales) ---
# API key de https://resend.com/api-keys
RESEND_API_KEY=
# Dominio verificado desde el que se envían los correos (ej. minichefs.app)
SEND_FROM_DOMAIN=

# --- Hotmart (webhook de pagos) ---
# Token secreto (HOTTOK) que Hotmart envía en el header X-HOTMART-HOTTOK.
# Se configura en Hotmart → Herramientas → Postback (Webhook).
HOTMART_HOTTOK=
